---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
import { services, type ServicePage } from '../data/services';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { page: s } }));
}

const { page } = Astro.props as { page: ServicePage };
const site = Astro.site!;
const url = new URL(`/${page.slug}`, site).href;
const others = services.filter((s) => s.slug !== page.slug);

const schema = [
  {
    '@type': 'Service',
    name: page.h1,
    serviceType: page.name,
    description: page.description,
    url,
    provider: { '@id': new URL('/#foretag', site).href },
    areaServed: { '@type': 'City', name: 'Hudiksvall' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: page.h1, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Layout title={`${page.metaTitle} | ${company.shortName}`} description={page.description} image={page.image} schema={schema}>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="container grid">
        <div>
          <nav class="crumbs load" aria-label="Brödsmulor">
            <a href="/">Start</a> <span aria-hidden="true">›</span> <span aria-current="page">{page.name}</span>
          </nav>
          <h1 class="load" style="--d: 1">{page.h1}</h1>
          <p class="lede load" style="--d: 2">{page.lede}</p>
          <div class="actions load" style="--d: 3">
            <a class="btn btn--primary" href="#kontakt">Boka kostnadsfri rådgivning <Icon name="arrow" /></a>
            <a class="btn btn--outline" href={company.phoneHref}><Icon name="phone" /> {company.phone}</a>
          </div>
        </div>
        <div class="hero__img load-image">
          <Picture
            src={page.image}
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(max-width: 900px) 92vw, 520px"
            alt={page.imageAlt}
            loading="eager"
            fetchpriority="high"
            style={page.imagePos ? `object-position: ${page.imagePos}` : undefined}
          />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container body">
        <article class="prose">
          {
            page.sections.map((sec, i) => (
              <div data-reveal style={`--i: ${i % 2}`}>
                <h2>{sec.h2}</h2>
                {sec.text.map((t) => <p>{t}</p>)}
              </div>
            ))
          }
        </article>

        <aside class="side" data-reveal="right">
          <div class="box">
            <h2 class="box__title">Fördelar</h2>
            <ul class="checks">{page.benefits.map((b) => <li><Icon name="check" /> {b}</li>)}</ul>
            <h2 class="box__title">Passar när</h2>
            <ul class="checks checks--home">{page.fit.map((b) => <li><Icon name="home" /> {b}</li>)}</ul>
            <a class="btn btn--primary box__btn" href="#kontakt">Få kostnadsfri rådgivning</a>
            <p class="box__note">Eller ring <a href={company.phoneHref}>{company.phone}</a></p>
          </div>
        </aside>
      </div>
    </section>

    <Faq items={page.faq} title={`Vanliga frågor om ${page.name.toLowerCase()}`} alt />

    <section class="section">
      <div class="container">
        <div class="section__head" data-reveal>
          <h2>Fler tjänster i Hudiksvall</h2>
        </div>
        <ul class="others">
          {
            others.map((o, i) => (
              <li data-reveal style={`--i: ${i}`}>
                <a class="other" href={`/${o.slug}`}>
                  <span class="other__icon"><Icon name={o.icon} /></span>
                  <span>{o.h1}</span>
                  <Icon name="arrow" class="other__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Contact arende={page.arende} title={`Kostnadsfri rådgivning om ${page.name.toLowerCase()}`} />
  </main>
  <Footer />
</Layout>

<style>
  .hero { padding-block: clamp(32px, 5vw, 72px); background: linear-gradient(var(--blue-50), #fff); }
  .grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .crumbs { font-size: var(--fs-sm); color: var(--muted); margin-bottom: var(--s-4); }
  .crumbs a { color: var(--blue-700); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .lede { font-size: var(--fs-lg); color: var(--muted); margin: var(--s-6) 0 0; max-width: 36em; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-8); }
  .hero__img { border-radius: var(--radius-lg); overflow: hidden; }
  .hero__img :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .body { display: grid; grid-template-columns: 1.4fr 0.8fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .prose { display: grid; gap: var(--s-12); max-width: 68ch; }
  .prose h2 { font-size: var(--fs-xl); margin-bottom: var(--s-4); }
  .prose p { color: var(--muted); font-size: var(--fs-lg); }
  .side { position: sticky; top: 100px; }
  .box { padding: var(--s-8); border-radius: var(--radius-lg); background: var(--surface-alt); }
  .box__title { font-size: var(--fs-lg); margin-bottom: var(--s-3); }
  .box__title:not(:first-child) { margin-top: var(--s-6); }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .checks li { display: flex; gap: 10px; font-weight: 500; }
  .checks :global(svg) { width: 20px; height: 20px; flex: none; margin-top: 3px; color: var(--success); }
  .checks--home :global(svg) { color: var(--blue-700); }
  .box__btn { width: 100%; margin-top: var(--s-8); }
  .box__note { margin: var(--s-3) 0 0; text-align: center; font-size: var(--fs-sm); color: var(--muted); }

  .others { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-4); }
  .other {
    display: flex; align-items: center; gap: 12px; height: 100%; padding: var(--s-6);
    border: 1px solid var(--line); border-radius: var(--radius); color: var(--blue-900); font-weight: 600; text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms var(--ease);
  }
  .other:hover { border-color: var(--blue-700); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .other__icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: var(--blue-100); color: var(--blue-700); }
  .other__icon :global(svg) { width: 24px; height: 24px; }
  .other :global(.other__arrow) { width: 20px; height: 20px; margin-left: auto; flex: none; color: var(--blue-700); transition: transform 200ms var(--ease); }
  .other:hover :global(.other__arrow) { transform: translateX(3px); }

  @media (max-width: 1000px) { .others { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .grid, .body { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 560px) {
    .others { grid-template-columns: 1fr; }
    .actions .btn { width: 100%; }
  }
</style>
