---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeatPumps from '../components/HeatPumps.astro';
import Services from '../components/Services.astro';
import Guarantee from '../components/Guarantee.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Värmepumpar i Hudiksvall | Anders Edh VVS & Kyla AB – IVT-partner"
  description="Anders Edh VVS & Kyla AB är auktoriserad IVT-återförsäljare och installatör i Hudiksvall. Bergvärme, luft/vatten, luft/luft och frånluft – installation och service. Kostnadsfri rådgivning: 070-207 32 55."
>
  <Header />
  <main id="main">
    <Hero />
    <HeatPumps />
    <Services />
    <Guarantee />
    <About />
    <Gallery />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  // Tona in innehåll när det scrollas fram
  const targets = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -60px 0px' },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
