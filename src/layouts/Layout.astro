---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOg from '../assets/img/installation-luft-vatten.jpg';
import { company, areas } from '../data/site';
import { services } from '../data/services';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** Extra JSON-LD-objekt för just den här sidan (FAQ, tjänst, brödsmulor …). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image = defaultOg, schema = [], noindex = false } = Astro.props;
const site = Astro.site!;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '');
const canonical = new URL(path || '/', site).href;
const ogImage = new URL(og.src, site).href;
const businessId = new URL('/#foretag', site).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': businessId,
  name: company.name,
  alternateName: 'Anders Edh VVS och Kyla',
  description:
    'Auktoriserad återförsäljare och installatör av IVT Värmepumpar i Hudiksvall. Installation och service av bergvärme, jordvärme, luft/vatten och frånluft samt VVS- och rörarbeten sedan 1988.',
  url: new URL('/', site).href,
  logo: new URL('/favicon.svg', site).href,
  image: ogImage,
  telephone: company.phoneE164,
  foundingDate: String(company.founded),
  founder: { '@type': 'Person', name: 'Anders Edh' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressRegion: 'Gävleborgs län',
    addressCountry: 'SE',
  },
  areaServed: areas.map((name) => ({ '@type': 'City', name })),
  knowsAbout: ['Värmepump', 'Bergvärme', 'Jordvärme', 'Luft/vattenvärmepump', 'Frånluftsvärmepump', 'VVS', 'IVT Värmepumpar'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Värmepumpar och VVS i Hudiksvall',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.h1, url: new URL(`/${s.slug}`, site).href },
    })),
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: company.name,
  url: new URL('/', site).href,
  inLanguage: 'sv-SE',
  publisher: { '@id': businessId },
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0e2552" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="geo.region" content="SE-X" />
    <meta name="geo.placename" content="Hudiksvall" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehållet</a>
    <slot />
    <script>
      // Inträden när innehåll scrollas fram, och siffror som räknar upp.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        if (reduce || !target) return;
        const suffix = el.dataset.suffix ?? '';
        const start = performance.now();
        const dur = 1200;
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = `${Math.round(target * eased)}${suffix}`;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.classList.add('is-in');
            if (el.dataset.count) countUp(el);
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            io.unobserve(el);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal], [data-animate]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
