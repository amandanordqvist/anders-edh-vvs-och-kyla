---
import Icon from './Icon.astro';
import { company, inquiryTypes } from '../data/site';
---

<section class="section" id="kontakt">
  <div class="container layout">
    <div class="info" data-reveal>
      <h2>Kostnadsfri rådgivning, besiktning och energikalkyl</h2>
      <p class="lead">Ring, mejla eller skicka en förfrågan så hör vi av oss. Vi hjälper dig hitta rätt värmepump för ditt hus.</p>

      <ul class="list">
        <li>
          <span class="list__icon"><Icon name="phone" /></span>
          <div><span class="list__label">Telefon</span><a href={company.phoneHref}>{company.phone}</a></div>
        </li>
        <li>
          <span class="list__icon"><Icon name="mail" /></span>
          <div><span class="list__label">E-post</span><a href={`mailto:${company.email}`}>Skicka e-post</a></div>
        </li>
        <li>
          <span class="list__icon"><Icon name="pin" /></span>
          <div>
            <span class="list__label">Adress</span>
            <a href={company.mapsUrl} target="_blank" rel="noopener">{company.street}, {company.postalCode} {company.city}</a>
          </div>
        </li>
      </ul>
    </div>

    <form
      class="form"
      id="contact-form"
      name="kontakt"
      method="POST"
      action="/tack"
      data-netlify="true"
      netlify-honeypot="bot-field"
      novalidate
      data-reveal
      style="--i: 1"
    >
      <input type="hidden" name="form-name" value="kontakt" />
      <input type="hidden" name="subject" value="Ny förfrågan från hemsidan (%{submissionId})" />
      <p class="visually-hidden" aria-hidden="true">
        <label>Fyll inte i detta: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <h3>Skicka en förfrågan</h3>
      <div class="row2">
        <div class="field">
          <label for="f-name">Namn</label>
          <input id="f-name" name="namn" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-phone">Telefon</label>
          <input id="f-phone" name="telefon" type="tel" autocomplete="tel" required />
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="f-email">E-post <span>(valfritt)</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="f-ort">Ort</label>
          <input id="f-ort" name="ort" type="text" autocomplete="address-level2" placeholder="t.ex. Hudiksvall" />
        </div>
      </div>
      <div class="field">
        <label for="f-type">Vad gäller det?</label>
        <select id="f-type" name="arende">
          {inquiryTypes.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="f-msg">Meddelande</label>
        <textarea id="f-msg" name="meddelande" rows="4" placeholder="Berätta gärna om huset och nuvarande uppvärmning."></textarea>
      </div>
      <button class="btn btn--primary submit" type="submit">Skicka förfrågan</button>
      <p class="note" role="status" aria-live="polite">Vi svarar så snart vi kan. Brådskande? Ring {company.phone}.</p>
    </form>
  </div>
</section>

<script>
  // Skickar till Netlify Forms utan sidomladdning. Utan JavaScript skickas formuläret vanligt och landar på /tack.
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const note = form.querySelector<HTMLElement>('.note')!;
  const button = form.querySelector<HTMLButtonElement>('.submit')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    let firstInvalid: HTMLInputElement | undefined;
    form.querySelectorAll<HTMLInputElement>('[required]').forEach((field) => {
      const ok = field.value.trim() !== '';
      field.setAttribute('aria-invalid', String(!ok));
      if (!ok) firstInvalid ??= field;
    });
    if (firstInvalid) {
      firstInvalid.focus();
      note.textContent = 'Fyll i namn och telefonnummer så att vi kan nå dig.';
      note.dataset.state = 'error';
      return;
    }

    button.disabled = true;
    button.textContent = 'Skickar…';
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      note.textContent = 'Tack! Din förfrågan är skickad – vi hör av oss så snart vi kan.';
      note.dataset.state = 'success';
    } catch {
      note.textContent = 'Något gick fel när förfrågan skulle skickas. Ring gärna 070-207 32 55 i stället.';
      note.dataset.state = 'error';
    } finally {
      button.disabled = false;
      button.textContent = 'Skicka förfrågan';
    }
  });
</script>

<style>
  .layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .lead { font-size: var(--fs-lg); color: var(--muted); margin: var(--s-6) 0 0; }
  .list { list-style: none; padding: 0; margin: var(--s-8) 0 0; display: grid; gap: var(--s-4); }
  .list li { display: flex; gap: var(--s-4); align-items: center; padding: var(--s-4); border-radius: var(--radius); background: var(--surface-alt); }
  .list__icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: #fff; color: var(--blue-700); }
  .list__icon :global(svg) { width: 22px; height: 22px; }
  .list__label { display: block; font-size: var(--fs-sm); color: var(--muted); }
  .list a { color: var(--blue-900); font-weight: 600; text-decoration: none; }
  .list a:hover { color: var(--blue-700); text-decoration: underline; }

  .form { padding: clamp(24px, 4vw, 40px); background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .form h3 { font-size: var(--fs-xl); margin-bottom: var(--s-6); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
  .field { margin-bottom: var(--s-4); }
  label { display: block; font-weight: 600; font-size: var(--fs-sm); margin-bottom: 6px; color: var(--ink); }
  label span { font-weight: 400; color: var(--muted); }
  input, select, textarea {
    width: 100%; min-height: 48px; padding: 12px 14px; font: inherit; font-size: 1rem; color: var(--ink);
    background: #fff; border: 1px solid #cfd7e4; border-radius: var(--radius-sm);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--blue-700); box-shadow: 0 0 0 4px rgb(26 63 143 / 0.15); }
  [aria-invalid='true'] { border-color: #c0392b; }
  textarea { resize: vertical; }
  .submit { width: 100%; margin-top: var(--s-2); }
  .submit:disabled { opacity: 0.7; cursor: wait; }
  .note { margin: var(--s-3) 0 0; font-size: var(--fs-sm); color: var(--muted); text-align: center; }
  .note[data-state='success'] { color: var(--success); font-weight: 600; }
  .note[data-state='error'] { color: #b0281c; font-weight: 600; }

  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .row2 { grid-template-columns: 1fr; gap: 0; } }
</style>
