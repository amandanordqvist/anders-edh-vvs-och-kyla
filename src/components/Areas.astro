---
// Rullande remsa med tjänster och orter – ger liv åt sidan och visar närområdet.
import { areas } from '../data/site';
import { services } from '../data/services';

const items = [
  ...services.map((s) => ({ label: s.name === 'Service' ? 'Service & felsökning' : s.name, href: `/${s.slug}` })),
  ...areas.map((a) => ({ label: `Värmepump ${a}`, href: '/#kontakt' })),
];
---

<div class="areas">
  <ul class="track">
    {items.map((it) => <li><a href={it.href}>{it.label}</a></li>)}
  </ul>
  <ul class="track" aria-hidden="true">
    {items.map((it) => <li><a href={it.href} tabindex="-1">{it.label}</a></li>)}
  </ul>
</div>

<style>
  .areas {
    display: flex; overflow: hidden; background: var(--blue-700); color: #fff;
    padding-block: 16px;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track { list-style: none; margin: 0; padding: 0; display: flex; flex: none; gap: 0; min-width: max-content; animation: marquee 45s linear infinite; }
  .areas:hover .track { animation-play-state: paused; }
  li { display: flex; align-items: center; white-space: nowrap; font-weight: 600; font-size: 0.975rem; }
  li::after { content: ''; width: 6px; height: 6px; margin-inline: 24px; border-radius: 50%; background: rgb(255 255 255 / 0.5); }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @keyframes marquee { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .areas { overflow-x: auto; }
  }
</style>
