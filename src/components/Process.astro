---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import vanImg from '../assets/img/servicebil-hudiksvall.jpg';
import { steps } from '../data/site';
---

<section class="section section--alt" id="sa-funkar-det">
  <div class="container layout">
    <div>
      <div class="section__head" data-reveal>
        <h2>Från första samtal till varmt hus</h2>
        <p>Totalentreprenad – du har en kontaktperson genom hela projektet och en installatör som är specialutbildad inom värmepumpar.</p>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--i: ${i}`}>
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="extra" data-reveal>
        <span class="extra__icon"><Icon name="wrench" /></span>
        <p><strong>Även VVS- och rörarbeten.</strong> Installationer, reparationer och servicejobb – alla uppdrag med kvalitet och noggrannhet.</p>
      </div>
    </div>

    <figure class="media" data-reveal style="--i: 1">
      <Picture
        src={vanImg}
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 92vw, 460px"
        alt="Anders Edh VVS & Kylas blå servicebil med IVT-släp"
      />
      <figcaption>Vi kommer hem till dig i Hudiksvall med omnejd.</figcaption>
    </figure>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); position: relative; }
  .steps::before { content: ''; position: absolute; left: 21px; top: 22px; bottom: 22px; width: 2px; background: var(--line); }
  .step { display: grid; grid-template-columns: 44px 1fr; gap: var(--s-4); position: relative; }
  .step__num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--blue-700); color: #fff; font-weight: 700; box-shadow: 0 0 0 6px var(--surface-alt); }
  .step h3 { margin: 8px 0 4px; }
  .step p { margin: 0; color: var(--muted); }

  .extra { display: flex; gap: var(--s-4); align-items: flex-start; margin-top: var(--s-8); padding: var(--s-6); background: #fff; border-radius: var(--radius); border: 1px solid var(--line); }
  .extra p { margin: 0; color: var(--muted); }
  .extra strong { color: var(--ink); }
  .extra__icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--blue-100); color: var(--blue-700); }
  .extra__icon :global(svg) { width: 22px; height: 22px; }

  .media { margin: 0; }
  .media :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 22% 40%; border-radius: var(--radius-lg); }
  .media figcaption { margin-top: var(--s-3); font-size: var(--fs-sm); color: var(--muted); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .media :global(img) { aspect-ratio: 16 / 10; }
  }
</style>
