---
import { faq } from '../data/faq';

interface Props {
  items?: { q: string; a: string }[];
  title?: string;
  alt?: boolean;
}
const { items = faq, title = 'Vanliga frågor om värmepump i Hudiksvall', alt = false } = Astro.props;
---

<section class:list={['section', { 'section--alt': alt }]} id="fragor">
  <div class="container layout">
    <div class="section__head" data-reveal>
      <h2>{title}</h2>
      <p>Hittar du inte svaret? Ring oss på 070-207 32 55 så hjälper vi dig.</p>
    </div>
    <div class="list">
      {
        items.map((f, i) => (
          <details class="item" data-reveal style={`--i: ${i % 4}`} open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="plus" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .list { display: grid; gap: var(--s-3); }
  .item { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); transition: border-color 200ms ease, box-shadow 200ms ease; }
  .item[open] { border-color: #cbd5e6; box-shadow: var(--shadow-md); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px 22px; cursor: pointer; list-style: none; font-weight: 650; color: var(--blue-900);
  }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--blue-100); transition: background-color 200ms ease, transform 300ms var(--ease); }
  .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; background: var(--blue-700); border-radius: 1px; }
  .plus::after { transform: rotate(90deg); transition: transform 300ms var(--ease); }
  .item[open] .plus { background: var(--blue-700); transform: rotate(180deg); }
  .item[open] .plus::before, .item[open] .plus::after { background: #fff; }
  .item[open] .plus::after { transform: rotate(0); }
  .answer { padding: 0 22px 20px; color: var(--muted); }
  .answer p { margin: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .item[open] .answer { animation: open 400ms var(--ease); }
  }
  @keyframes open { from { opacity: 0; transform: translateY(-6px); } }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
</style>
