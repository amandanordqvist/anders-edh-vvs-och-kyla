  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  berg: '<path d="M3 10h18"/><path d="m7 10 5-6 5 6"/><path d="M12 10v11"/><path d="M12 21c-2-1.5-2-3 0-4.5s2-3 0-4.5"/>',
  luftvatten: '<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="9" cy="12" r="3.2"/><path d="M15.5 9.5h2.5M15.5 12h2.5M15.5 14.5h2.5"/>',
  luftluft: '<rect x="3" y="5" width="18" height="7" rx="2"/><path d="M6 9h12"/><path d="M8 15c0 2-1 2.5-1 4M12 15c0 2-1 2.5-1 4M16 15c0 2-1 2.5-1 4"/>',
  franluft: '<path d="M4 11 12 4l8 7v9H4z"/><path d="M9 15c1-1.3 2-1.3 3 0s2 1.3 3 0"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  home: '<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/>',
  wrench: '<path d="M14.5 6.5a4 4 0 0 0 5 5L12 19a2.1 2.1 0 0 1-3-3l7.5-7.5a4 4 0 0 0-5-5l2.5 2.5-1 2-2 1z"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
