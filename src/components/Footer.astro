---
import Icon from './Icon.astro';
import { company, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__about">
      <strong class="footer__name">{company.name}</strong>
      <p>Auktoriserad IVT-partner – installation och service av värmepumpar i Hudiksvall med omnejd sedan {company.founded}.</p>
    </div>
    <p>
      <a href={company.phoneHref}>{company.phone}</a><br />
      {company.street}<br />
      {company.postalCode} {company.city}
    </p>
    <nav class="footer__links" aria-label="Sidfot">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {company.name}</span>
    <span>IVT är ett varumärke som tillhör Bosch Thermoteknik AB.</span>
  </div>
</footer>

<a class="call-fab" href={company.phoneHref} aria-label={`Ring ${company.phone}`}>
  <Icon name="phone" />
  Ring oss
</a>

<style>
  .footer { background: var(--navy-900); color: #b9c8da; padding: 64px 0 24px; font-size: 0.95rem; }
  .footer a { color: #fff; text-decoration: none; }
  .footer a:hover { color: var(--copper-300); }
  .footer__inner {
    display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px;
    padding-bottom: 40px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer__name { display: block; font-family: var(--font-head); font-size: 1.2rem; color: #fff; margin-bottom: 10px; }
  .footer__links { display: flex; flex-direction: column; gap: 8px; }
  .footer__bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding-top: 22px; font-size: 0.82rem; color: #8597ae; }

  .call-fab {
    display: none; position: fixed; right: 16px; bottom: 16px; z-index: 60;
    align-items: center; gap: 8px; padding: 14px 20px; border-radius: 999px;
    background: var(--copper-500); color: #fff; font-weight: 700; text-decoration: none;
    box-shadow: 0 10px 28px rgba(208, 112, 47, 0.45);
  }
  .call-fab :global(svg) { width: 20px; height: 20px; }

  @media (max-width: 900px) {
    .footer__inner { grid-template-columns: 1fr 1fr; }
    .footer__about { grid-column: span 2; }
    .footer { padding-bottom: 96px; }
    .call-fab { display: inline-flex; }
  }
  @media (max-width: 600px) {
    .footer__inner { grid-template-columns: 1fr; }
    .footer__about { grid-column: auto; }
  }
</style>
