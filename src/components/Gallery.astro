---
import { Picture } from 'astro:assets';
import bergvarme from '../assets/img/installation-bergvarme.jpg';
import luftVatten from '../assets/img/installation-luft-vatten.jpg';
import installator from '../assets/img/ivt-installator.jpg';
import servicebil from '../assets/img/servicebil-hudiksvall.jpg';

const items = [
  { src: bergvarme, caption: 'Större anläggning i fastighet', alt: 'Värmepumpsanläggning med flera IVT-enheter och tankar i en källare', pos: 'center 55%', wide: true },
  { src: luftVatten, caption: 'Luft/vatten i villa', alt: 'IVT luft/vattenvärmepump installerad i ett grovkök', pos: 'center 62%' },
  { src: installator, caption: 'Certifierad IVT-installatör', alt: 'Installatör med verktyg och IVT Värmepumpar på arbetsbyxorna', pos: 'center' },
  { src: servicebil, caption: 'På väg till nästa kund', alt: 'Blå servicebil med IVT-släp', pos: '30% 38%' },
];
---

<section class="section section--alt" id="bilder">
  <div class="container">
    <div class="section__head" data-reveal>
      <h2>Från våra uppdrag</h2>
      <p>Ett urval av installationer i Hudiksvall med omnejd.</p>
    </div>
    <div class="gallery">
      {
        items.map((it, i) => (
          <figure class:list={['item', { 'item--wide': it.wide }]} data-reveal style={`--i: ${i}`}>
            <Picture
              src={it.src}
              formats={['avif', 'webp']}
              widths={[400, 640, 960]}
              sizes={it.wide ? '(max-width: 760px) 92vw, 600px' : '(max-width: 760px) 92vw, 300px'}
              alt={it.alt}
              style={`object-position: ${it.pos}`}
            />
            <figcaption>{it.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, 260px); gap: var(--s-4); }
  .item { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius); }
  .item--wide { grid-row: span 2; }
  .item:nth-child(4) { grid-column: span 2; }
  .item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  .item:hover :global(img) { transform: scale(1.03); }
  .item figcaption {
    position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px;
    background: rgb(255 255 255 / 0.94); color: var(--blue-900); font-size: var(--fs-sm); font-weight: 600;
  }

  @media (max-width: 760px) {
    .gallery { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .item { aspect-ratio: 1; }
    .item--wide, .item:nth-child(4) { grid-column: span 2; grid-row: auto; aspect-ratio: 16 / 10; }
  }
</style>
