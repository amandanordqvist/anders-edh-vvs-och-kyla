---
import { Picture } from 'astro:assets';
import bergvarme from '../assets/img/installation-bergvarme.jpg';
import luftVatten from '../assets/img/installation-luft-vatten.jpg';
import installator from '../assets/img/ivt-installator.jpg';

const items = [
  { src: bergvarme, caption: 'Bergvärme – större anläggning', alt: 'Installation av IVT bergvärmepumpar med ackumulatortankar i en fastighet i Hudiksvall', pos: 'center 55%', wide: true },
  { src: luftVatten, caption: 'Luft/vatten i villa', alt: 'IVT luft/vattenvärmepump installerad i ett grovkök i Hudiksvall', pos: 'center 62%' },
  { src: installator, caption: 'Certifierad IVT-installatör', alt: 'Certifierad IVT-installatör med verktyg', pos: 'center' },
];
---

<section class="section section--alt" id="bilder">
  <div class="container">
    <div class="section__head" data-reveal>
      <h2>Från våra uppdrag</h2>
      <p>Ett urval av värmepumpsinstallationer i Hudiksvall med omnejd.</p>
    </div>
    <div class="gallery">
      {
        items.map((it, i) => (
          <figure class:list={['item', { 'item--wide': it.wide }]} data-reveal="image" style={`--i: ${i}`}>
            <Picture
              src={it.src}
              formats={['avif', 'webp']}
              widths={[400, 640, 960]}
              sizes={it.wide ? '(max-width: 760px) 92vw, 680px' : '(max-width: 760px) 92vw, 480px'}
              alt={it.alt}
              style={`object-position: ${it.pos}`}
            />
            <figcaption>{it.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: repeat(2, 260px); gap: var(--s-4); }
  .item { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius-lg); }
  .item--wide { grid-row: span 2; }
  .item :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .item :global(picture) { display: block; height: 100%; overflow: hidden; }
  .item :global(picture img) { transition: transform 600ms var(--ease); }
  .item:hover :global(picture img) { transform: scale(1.04); }
  .item figcaption {
    position: absolute; left: 14px; bottom: 14px; padding: 6px 14px; border-radius: 999px;
    background: rgb(255 255 255 / 0.95); color: var(--blue-900); font-size: var(--fs-sm); font-weight: 600;
  }
  @media (max-width: 760px) {
    .gallery { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .item { aspect-ratio: 1; }
    .item--wide { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3; }
  }
</style>
