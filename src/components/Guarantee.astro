---
import Icon from './Icon.astro';
import { guarantees } from '../data/site';
---

<section class="guarantee" id="trygghet">
  <div class="container">
    <div class="head" data-reveal>
      <span class="head__icon"><Icon name="shield" /></span>
      <div>
        <h2>Trygghet som ingår från dag ett</h2>
        <p>Köper du en IVT-värmepump via oss får du ett komplett skyddsprogram som kombinerar garanti och försäkring.</p>
      </div>
    </div>

    <div class="grid">
      {
        guarantees.map((g, i) => (
          <div class:list={['item', { 'item--highlight': i === guarantees.length - 1 }]} data-reveal style={`--i: ${i}`}>
            <span class="item__num">{g.num}</span>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .guarantee { background: var(--blue-900); color: #c9d5ec; padding-block: var(--section); }
  .head { display: flex; gap: var(--s-6); align-items: flex-start; max-width: 760px; margin-bottom: var(--s-12); }
  .head__icon { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--radius); background: rgb(255 255 255 / 0.1); color: #fff; }
  .head__icon :global(svg) { width: 30px; height: 30px; }
  h2 { color: #fff; }
  .head p { margin: var(--s-4) 0 0; font-size: var(--fs-lg); }

  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-4); }
  .item { padding: var(--s-8) var(--s-6); border-radius: var(--radius); background: rgb(255 255 255 / 0.06); }
  .item__num { display: block; font-size: var(--fs-2xl); font-weight: 800; letter-spacing: -0.03em; color: #fff; margin-bottom: var(--s-4); }
  .item h3 { color: #fff; margin-bottom: var(--s-2); }
  .item p { margin: 0; font-size: 0.975rem; }
  .item--highlight { background: var(--blue-700); color: #e3eafa; }

  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .head { flex-direction: column; gap: var(--s-4); }
  }
</style>
