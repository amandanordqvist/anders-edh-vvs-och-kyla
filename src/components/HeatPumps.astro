---
import { heatPumps } from '../data/site';

// Linjeikoner (48×48) för respektive värmepumpstyp
const icons = {
  berg: ['M6 20h36', 'M24 20v22', 'M24 42c-3-3-3-6 0-9s3-6 0-9', 'M14 20 24 8l10 12'],
  luftvatten: ['M9 12h30a3 3 0 0 1 3 3v18a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3Z', 'M18 17v14M11 24h14', 'M31 18h6M31 24h6M31 30h6'],
  luftluft: ['M9 10h30a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3Z', 'M11 19h26', 'M14 30c0 3-2 4-2 7M24 30c0 3-2 4-2 7M34 30c0 3-2 4-2 7'],
  franluft: ['M8 22 24 9l16 13v18H8Z', 'M30 14V7h5v11', 'M17 31c2-3 4-3 6 0s4 3 6 0'],
};
---

<section class="section" id="varmepumpar">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="eyebrow">Hela IVT:s program</p>
      <h2>Rätt värmepump för just ditt hus</h2>
      <p>
        Modern design och energieffektiv uppvärmning. Vi anpassar varje lösning efter förutsättningarna i din fastighet –
        tomt, husets storlek, nuvarande värmesystem och hur ni bor.
      </p>
    </header>

    <div class="cards">
      {
        heatPumps.map((pump) => (
          <article class="card" data-reveal>
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 48 48">
                {pump.icon === 'luftvatten' && <circle cx="18" cy="24" r="7" />}
                {icons[pump.icon].map((d) => <path d={d} />)}
              </svg>
            </div>
            <h3>{pump.title}</h3>
            <p>{pump.text}</p>
            <ul class="card__list">
              {pump.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .card {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 30px 26px; display: flex; flex-direction: column;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s, opacity 0.6s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: transparent; }
  .card p { color: var(--muted); font-size: 0.98rem; }
  .card__icon {
    width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center;
    background: var(--blue-100); margin-bottom: 20px; transition: background-color 0.25s;
  }
  .card__icon svg {
    width: 34px; height: 34px; fill: none; stroke: var(--navy-800);
    stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
  }
  .card:hover .card__icon { background: var(--copper-100); }
  .card:hover .card__icon svg { stroke: var(--copper-600); }
  .card__list { list-style: none; margin: auto 0 0; padding: 16px 0 0; border-top: 1px dashed var(--line); font-size: 0.92rem; }
  .card__list li { padding-left: 22px; position: relative; margin-bottom: 6px; }
  .card__list li::before {
    content: ''; position: absolute; left: 0; top: 0.5em; width: 10px; height: 10px; border-radius: 50%;
    background: var(--copper-500);
  }

  @media (max-width: 1080px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } }
</style>
