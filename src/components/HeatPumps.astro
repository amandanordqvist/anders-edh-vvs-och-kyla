---
import Icon from './Icon.astro';
import { heatPumps } from '../data/site';
---

<section class="section" id="varmepumpar">
  <div class="container">
    <div class="section__head" data-reveal>
      <h2>Rätt värmepump för ditt hus</h2>
      <p>Vi installerar hela IVT:s program av värmepumpar i Hudiksvall med omnejd och anpassar lösningen efter just din fastighet – tomt, husets storlek och nuvarande värmesystem.</p>
    </div>

    <div class="grid">
      {
        heatPumps.map((p, i) => (
          <div data-reveal style={`--i: ${i}`}>
          <article class="card">
            <span class="card__icon"><Icon name={p.icon} /></span>
            <h3><a class="card__title" href={p.href}>{p.title}</a></h3>
            <p>{p.text}</p>
            <p class="card__fit"><Icon name="home" /> {p.fit}</p>
            <div class="card__links">
              <a class="card__link" href={p.href}>
                Läs mer <Icon name="arrow" /><span class="visually-hidden"> om {p.title.toLowerCase()} i Hudiksvall</span>
              </a>
              <a class="card__link card__link--soft" href="#kontakt" data-arende={p.arende}>Få rådgivning</a>
            </div>
          </article>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Förväljer ärendet i kontaktformuläret.
  document.querySelectorAll<HTMLAnchorElement>('.card__link').forEach((a) =>
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#f-type');
      if (select && a.dataset.arende) select.value = a.dataset.arende;
    }),
  );
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-6); }
  .card {
    height: 100%; display: flex; flex-direction: column; padding: var(--s-8) var(--s-6);
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }
  .card:hover { border-color: #cbd5e6; box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .card__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: var(--radius); background: var(--blue-100); color: var(--blue-700); margin-bottom: var(--s-6); }
  .card__icon :global(svg) { width: 28px; height: 28px; }
  .card h3 { margin-bottom: var(--s-3); }
  .card p { color: var(--muted); font-size: 0.975rem; }
  .card__fit { display: flex; gap: 8px; align-items: flex-start; margin-top: auto; padding-top: var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm) !important; color: var(--ink) !important; font-weight: 500; }
  .card__fit :global(svg) { width: 18px; height: 18px; flex: none; margin-top: 2px; color: var(--blue-700); }
  .card__title { color: inherit; text-decoration: none; }
  .card__title::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .card { position: relative; }
  .card__links { display: flex; justify-content: space-between; align-items: center; gap: 12px; position: relative; z-index: 1; }
  .card__link--soft { color: var(--muted); font-weight: 500; }
  .card__link--soft:hover { color: var(--blue-700); }
  .card:hover .card__icon { transform: translateY(-3px) rotate(-6deg); background: var(--blue-700); color: #fff; }
  .card__icon { transition: transform 300ms var(--ease), background-color 300ms ease, color 300ms ease; }
  .card__link { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.95rem; text-decoration: none; }
  .card__link :global(svg) { width: 18px; height: 18px; transition: transform 200ms var(--ease); }
  .card__link:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1080px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
