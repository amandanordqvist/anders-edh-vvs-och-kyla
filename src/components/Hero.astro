---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import heroImg from '../assets/img/installation-luft-vatten.jpg';
import { company, yearsInBusiness } from '../data/site';
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="load" style="--d: 0">Värmepumpar i Hudiksvall</h1>
      <p class="hero__lede load" style="--d: 1">
        Behöver du en ny värmepump i Hudiksvall? Som auktoriserad IVT-partner installerar och servar vi bergvärme,
        luft/vatten och frånluft – från kostnadsfri rådgivning och energikalkyl till färdig anläggning.
      </p>
      <div class="hero__actions load" style="--d: 2">
        <a class="btn btn--primary" href="#kontakt">Boka kostnadsfri rådgivning <Icon name="arrow" /></a>
        <a class="btn btn--outline" href={company.phoneHref}><Icon name="phone" /> {company.phone}</a>
      </div>
      <ul class="hero__points load" style="--d: 3">
        <li><Icon name="check" /> Auktoriserad IVT-installatör</li>
        <li><Icon name="check" /> {yearsInBusiness} år i branschen</li>
        <li><Icon name="check" /> Lokalt i Hudiksvall</li>
      </ul>
    </div>

    <figure class="hero__media">
      <div class="hero__img load-image">
      <Picture
        src={heroImg}
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 92vw, 520px"
        alt="Nyinstallerad IVT luft/vattenvärmepump med varmvattenberedare i en villa i Hudiksvall"
        loading="eager"
        fetchpriority="high"
      />
      </div>
      <figcaption class="hero__badge load" style="--d: 5"><span class="float hero__badge-inner">
        <span class="hero__badge-icon"><Icon name="shield" /></span>
        <span><strong>Upp till 20 års trygghet</strong>med IVT Plusförsäkring</span></span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(40px, 6vw, 88px) clamp(56px, 7vw, 104px); background: linear-gradient(var(--blue-50), #fff); }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }

  .hero__lede { font-size: var(--fs-lg); color: var(--muted); margin: var(--s-6) 0 0; max-width: 34em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-8); }
  .hero__points { list-style: none; padding: 0; margin: var(--s-8) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); color: var(--ink); font-weight: 500; font-size: 0.975rem; }
  .hero__points li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__points :global(svg) { width: 20px; height: 20px; color: var(--success); }

  .hero__media { position: relative; margin: 0; }
  .hero__media :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 62%; border-radius: var(--radius-lg); }
  .hero__img { border-radius: var(--radius-lg); overflow: hidden; }
  .hero__badge { position: absolute; left: -24px; bottom: 32px; }
  .hero__badge-inner {
    display: flex; align-items: center; gap: 12px; padding: 14px 18px;
    background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-lg);
    font-size: var(--fs-sm); color: var(--muted); line-height: 1.35;
  }
  .hero__badge strong { display: block; color: var(--blue-900); font-size: 0.975rem; }
  .hero__badge-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--blue-100); color: var(--blue-700); }
  .hero__badge-icon :global(svg) { width: 22px; height: 22px; }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { max-width: 520px; }
    .hero__media :global(img) { aspect-ratio: 4 / 3.4; }
    .hero__badge { left: 16px; bottom: 16px; }
  }
  @media (max-width: 520px) {
    .hero__actions .btn { width: 100%; }
  }
</style>
